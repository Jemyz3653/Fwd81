# Каталог сборки
/build/
/out/

# Мусор Visual Studio
.vs/
*.user
*.suo
*.pdb.tmp

# Резервные копии, которые создаёт `fwd81cli patch`
*.orig

# Копия System32 из Windows 8.1: сотни мегабайт системных DLL.
# В репозиторий не кладём никогда — только сам каталог, чтобы путь существовал.
/data/system32-win81/*
!/data/system32-win81/.gitkeep

# Выгрузки exportdiff и всё, что из них выводится. В репозиторий не кладём:
# исходные данные (System32 из 8.1) там тоже нет, а гонять по 6+ МБ JSON в
# истории незачем. Каталог заготовок _generated_stubs — тоже производное от этих
# данных, живёт только локально, пока функцию не перенесут в настоящий файл.
/data/exports-*.json
/data/missing.json
/data/coverage.json
/src/libs/_generated_stubs/

# Python
__pycache__/
*.pyc
