# По умолчанию в репозитории переводы строк LF.
* text=auto eol=lf

# cmd.exe разваливает блоки if(...), если в .bat нет CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell 5.1 читает .ps1 без BOM как ANSI и ломается на кириллице,
# поэтому .ps1 хранится в UTF-8 с BOM (сама метка BOM — обычные байты в файле,
# git их сохраняет) и с CRLF.
*.ps1 text eol=crlf

# Тексты лицензий не трогать.
LICENSE     text eol=lf
LICENSE.MIT text eol=lf

*.exe binary
*.dll binary
*.lib binary
*.png binary
*.ico binary
